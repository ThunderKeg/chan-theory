      "page": 574,
      "top": 311.6,
      "bottom": 328.7,
      "x0": 90.0,
      "x1": 234.6,
      "text": "7、笔的基本形态："
    },
    {
      "type": "image",
      "page": 574,
      "top": 354.9,
      "bottom": 562.7,
      "x0": 90.0,
      "x1": 503.6,
