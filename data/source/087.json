      "top": 387.1,
      "bottom": 409.0,
      "x0": 122.9,
      "x1": 365.6,
      "text": "(cid:16938)(cid:16938)(cid:3933)(cid:11534)(cid:1123)(cid:7509)(cid:17318)(cid:2293)(cid:11450)(cid:9546)(cid:2380)"
    },
