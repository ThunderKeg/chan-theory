      "src": "assets/book-images/055/page-0512-Im294.jpg",
      "pixelWidth": 690,
      "pixelHeight": 361,
      "sha256": "8539bbf65829a910b008bacede11d8bbc79ff5dae1dfd4250c7e866ebb9d82cf"
    },
