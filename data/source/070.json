      "type": "line",
      "page": 699,
      "top": 619.8,
      "bottom": 631.8,
      "x0": 90.0,
      "x1": 387.0,
      "text": "MACD 就可以，还用其他干什么？ 2007-08-16 15:51:35"
    },
