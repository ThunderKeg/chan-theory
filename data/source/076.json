{
  "schemaVersion": 1,
  "id": "076",
  "number": 76,
  "kind": "lesson",
  "title": "逗庄家玩的一些杂史 2",
  "start": {
    "page": 755,
    "top": 344.8
  },
  "end": {
    "page": 762,
    "top": 717.7
  },
  "eventCount": 181,
