      "pixelHeight": 419,
      "sha256": "16922c965eb6f4f90230e7c0c040a8ce6a6a6526b68eb1b4912b719f81a6a5f7"
    },
    {
      "type": "image",
      "page": 430,
      "top": 89.3,
      "bottom": 366.8,
      "x0": 90.0,
      "x1": 499.3,
      "name": "Im249",
