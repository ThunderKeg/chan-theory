            "sha256": "3612cc37c0a58e7bc053b45c46a10429e08472f1905d5143f541ca7ce7c8c3f7"
          }
        },
        {
          "type": "image",
          "src": "assets/book-images/073/page-0732-Im451.jpg",
          "alt": "上证指数一分钟走势图，标注 44 至 63 的分段序号、4646.88 与 5191.86 点位，并附成交量和 MACD",
          "caption": "上证指数一分钟走势：44 至 63 段与 MACD",
          "source": {
            "page": 732,
            "top": 446.6,
